# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=zana_user
DB_PASS=your_secure_password
DB_NAME=zana_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Cors Configuration
CORS_ORIGIN=http://localhost:5173

# Log Level
LOG_LEVEL=debug

# syntax=docker/dockerfile:1
FROM node:20-alpine AS base

# Install necessary build tools and client utilities
RUN apk add --no-cache python3 make g++ wget curl mysql-client

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy source code
COPY . .

# Ensure runtime directories exist and are writable by the non-root node user
RUN mkdir -p /app/logs /app/uploads && chown -R node:node /app/logs /app/uploads

# Set environment
ENV NODE_ENV=production
ENV PORT=5000

# Use non-root node user
USER node

EXPOSE 5000

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:5000/ || exit 1

# Start production server directly with node
CMD ["node", "src/server.js"]

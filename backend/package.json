    "erp",
    "crm",
    "african-smes"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ant-design/charts": "^2.6.4",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "mysql2": "^3.15.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.14.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",

{
  "name": "zana-backend",
  "version": "1.0.0",
  "description": "Zana - POS, ERM, and CRM system for African SMEs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check-deps": "node scripts/check-dependencies.js",
    "test": "NODE_ENV=test jest --runInBand --forceExit --detectOpenHandles",
    "lint": "eslint src/",
    "db:create": "mysql -u root -p < database/init.sql"
  },
  "keywords": [

# Server Configuration
# HTTP port for the Express backend server
PORT=3000
# Environment mode (development, test, production)
NODE_ENV=development

# CORS & Domain Configuration
# Comma-separated allowed HTTP origins for CORS policy
ALLOWED_ORIGINS=http://localhost:5173
# Primary frontend client URL
FRONTEND_URL=http://localhost:5173
# Business name displayed in email templates and invoices
COMPANY_NAME="Zana POS"

# Database Configuration (MySQL)
# Host address of the MySQL server
DB_HOST=localhost
# Port of the MySQL server
DB_PORT=3306
# Database username
DB_USER=root
# Database password (unified canonical variable name)
DB_PASS=your_password
# Main application database name
DB_NAME=zana_db
# Test database name (used during Jest automated test runs)
TEST_DB_NAME=zana_pos_test

# Redis Cache & Queue Configuration
# Full Redis connection URL (overrides HOST/PORT if set)
REDIS_URL=
# Redis server hostname (used if REDIS_URL is not set)
REDIS_HOST=localhost
# Redis server port
REDIS_PORT=6379
# Redis authentication password
REDIS_PASSWORD=
# Enable TLS for Redis connection (true or false)
REDIS_TLS=false

# JWT Authentication Configuration (RS256 Asymmetric Keypair)
# Token expiration duration (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h
# RSA Private Key string used by backend to sign tokens
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# RSA Public Key string used by backend/middleware to verify tokens
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Insights Engine & Downstream AI Service Configuration
# High expense alert trigger threshold amount (KSh)
INSIGHT_HIGH_EXPENSE_THRESHOLD=5000
# Critical low-stock unit threshold
INSIGHT_CRITICAL_STOCK_UNITS=5
# Sales drop trigger threshold ratio
INSIGHT_SALES_DROP_THRESHOLD=0.5
# Revenue decline trigger threshold ratio
INSIGHT_REVENUE_DECLINE_THRESHOLD=0.01
# Stock depletion estimation window in days
INSIGHT_STOCK_DEPLETION_DAYS=7
# Lookback window for calculating sales velocity (days)
INSIGHT_VELOCITY_LOOKBACK_DAYS=14
# HTTP timeout for requests sent to downstream AI service (ms)
AI_SERVICE_TIMEOUT_MS=15000
# Downstream AI/ML Service Base URL
AI_SERVICE_BASE_URL=http://localhost:8000
# Downstream AI/ML Service URL (fallback alias)
AI_SERVICE_URL=http://localhost:8000
# API key or pre-signed token passed to downstream AI service
AI_SERVICE_API_KEY=your_ai_service_api_key_here
# Internal proxy URL for system health reporting
AI_PROXY_URL=http://localhost:3000/api/ai/status
# Enable external market alerts integration (true/false)
MARKET_ALERTS_ENABLED=false
# External market alerts endpoint URL
MARKET_ALERTS_URL=http://localhost:8000/alerts

# M-Pesa Daraja API Configuration
# Environment mode (sandbox or production)
MPESA_ENV=sandbox
# Consumer key from Safaricom Daraja Developer portal
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
# Consumer secret from Safaricom Daraja Developer portal
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
# Business shortcode (Paybill/Till number)
MPESA_SHORTCODE=174379
# Passkey for STK Push initiation
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Publicly accessible URL for M-Pesa IPN callbacks
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# Flutterwave Card Payment Configuration
# Flutterwave secret API key
FLW_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key_here
# Frontend redirect URL after completing card payment
FLW_REDIRECT_URL=http://localhost:5173/card-redirect

# SMTP Email Service Configuration
# SMTP server hostname
SMTP_HOST=smtp.example.com
# SMTP server port (e.g. 587 or 465)
SMTP_PORT=587
# Use TLS/SSL (true for 465, false for 587/25)
SMTP_SECURE=false
# SMTP authentication username
SMTP_USER=user@example.com
# SMTP authentication password
SMTP_PASS=secret
# Sender email address for outgoing system emails
SMTP_FROM=noreply@example.com

# Encryption Secret
# 32-byte secret key used to encrypt sensitive credentials stored at rest
ENCRYPTION_SECRET=e7b4198c61fa2d75a02482310bf8b975e5330e2fbd08544c4897f1f415ef414a

+      # Export it yourself before `docker compose up`, e.g.:
+      #   SENTRY_RELEASE=zana-pos-backend@$(git rev-parse HEAD) docker compose -f docker-compose.prod.yml up -d --build
+      # Left blank here on purpose: instrument.js's own fallback
+      # (zana-pos-backend@<package.json version>) is more honest than a

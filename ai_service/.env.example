# JWT Configuration
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=./jwt_public_key.pem

# CORS Configuration
# In production, set this to the backend's internal URL (e.g. http://backend:3000) to only accept requests from the backend service.
ALLOWED_ORIGINS=http://localhost:3000

# Sentry Error Tracking & Performance Monitoring
# Sentry Data Source Name (leave empty to disable in local development)
SENTRY_DSN=
# Deployment environment (development, staging, production)
SENTRY_ENVIRONMENT=development
# Release identifier (e.g. zana-pos-ai@1.0.0 or git commit SHA)
SENTRY_RELEASE=
# Performance tracing sample rate (0.0 to 1.0; 0.1 recommended for 10% in production)
SENTRY_TRACES_SAMPLE_RATE=0.1


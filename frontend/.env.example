# Frontend Environment Configuration
VITE_API_URL=http://localhost:3000
VITE_AI_SERVICE_URL=http://localhost:8000

# Sentry Observability Configuration
# Client-side Sentry Data Source Name (safe to expose to browser, leave empty to disable)
VITE_SENTRY_DSN=
# Deployment environment (development, staging, production)
VITE_SENTRY_ENVIRONMENT=development
# Release identifier (e.g. zana-pos-frontend@1.0.0 or git commit SHA)
VITE_SENTRY_RELEASE=
# Performance tracing sample rate (0.0 to 1.0; 0.1 recommended for 10% in production)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

+  return new Date(dateString).toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'long',
+    day: 'numeric',
+    timeZone: SHOP_TIMEZONE
+  });
+}
+
+// Short date, e.g. "Aug 26, 2026" — for tables and compact lists.
